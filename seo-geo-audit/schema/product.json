{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{PRODUCT_NAME}}",
  "image": [
    "{{PRIMARY_IMAGE_URL}}",
    "{{SECONDARY_IMAGE_URL}}"
  ],
  "description": "{{PRODUCT_DESCRIPTION}}",
  "sku": "{{SKU}}",
  "gtin": "{{GTIN_OR_OMIT}}",
  "brand": {
    "@type": "Brand",
    "name": "{{BRAND_NAME}}"
  },
  "offers": {
    "@type": "Offer",
    "url": "{{PRODUCT_URL}}",
    "priceCurrency": "{{ISO_CURRENCY_CODE}}",
    "price": "{{PRICE}}",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "priceValidUntil": "{{YYYY_MM_DD}}"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{AVG_RATING}}",
    "reviewCount": "{{REVIEW_COUNT}}"
  }
}
