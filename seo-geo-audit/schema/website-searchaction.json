{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{SITE_NAME}}",
  "url": "{{HOMEPAGE_URL}}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{HOMEPAGE_URL}}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
